# Public ports
FRONTEND_PORT=80
BACKEND_PORT=8000
POSTGRES_PORT=5432

# PostgreSQL
POSTGRES_DB=stockpilot
POSTGRES_USER=stockpilot
POSTGRES_PASSWORD=replace_with_a_strong_password

# Browser origins allowed to call FastAPI directly, comma separated
FRONTEND_ORIGINS=http://localhost,http://127.0.0.1

# Optional OpenAI-compatible LLM endpoint
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=

# Financial PDF limits
PDF_MAX_FILE_SIZE_MB=20
PDF_MAX_PAGES=300
PDF_MAX_TEXT_CHARS=200000

